## emu16K is dedicated to the public domain.
## attribution appreciated; not required.


## to build: 	"$ make -f mkf".
## to execute:	"$ make -f mkf run".
## to clean:	"$ make -f mfk clr". 


C++ = g++
FLG = -std=c++03 -O0
SRC = src/emu.c++ 				\
		src/emu16K/emu16K.c++
OUT = bin/emu16K

.DEFAULT_GOAL = run
.PHONY: ini all run clr


ini:
	@mkdir -p bin
	@rm -f $(OUT)

all:	ini
	@$(C++) $(FLG) $(SRC) -o $(OUT)
	
run:	all
	@./$(OUT)
	
clr:
	@rm -rf bin/
